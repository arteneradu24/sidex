<% content_for :title, @post.title %>

<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @post.published_at.present? %>
      <time class="text-sm text-gray-500"><%= l(@post.published_at.to_date, format: :long) %></time>
    <% end %>
    <h1 class="section-title mt-2"><%= @post.title %></h1>
    <% if @post.excerpt.present? %>
      <p class="section-subtitle"><%= @post.excerpt %></p>
    <% end %>
  </div>
</section>

<article class="py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="aspect-video rounded-2xl overflow-hidden mb-12">
      <% cover = cover_image_for(@post, width: 1200, height: 675) %>
      <% if cover.is_a?(String) %>
        <img src="<%= cover %>" alt="<%= @post.title %>" class="w-full h-full object-cover">
      <% else %>
        <%= image_tag cover, alt: @post.title, class: "w-full h-full object-cover" %>
      <% end %>
    </div>

    <div class="prose-themed">
      <%= @post.content %>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200">
      <%= link_to "&larr; Zurück zum #{current_site.blog_label}".html_safe, posts_path, class: "text-primary font-semibold hover:underline" %>
    </div>
  </div>
</article>
