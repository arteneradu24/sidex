<% content_for :title, current_site.blog_label %>

<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="section-title"><%= current_site.blog_label %></h1>
    <p class="section-subtitle">Neuigkeiten, Einblicke und Updates aus unserem Unternehmen.</p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @posts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @posts.each do |post| %>
          <%= render "posts/card", post: post %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500">Noch keine Beiträge veröffentlicht.</p>
      </div>
    <% end %>
  </div>
</section>
