<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-gray-900">Control Panel</h1>
      <p class="text-gray-500 mt-2">Sign in to manage your website</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <%= render "shared/flash" %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, class: "cp-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "cp-input" %>
        </div>
        <div>
          <%= f.label :password, class: "cp-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "cp-input" %>
        </div>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
          <%= f.label :remember_me, class: "text-sm text-gray-600" %>
        </div>
        <%= f.submit "Sign in", class: "btn-primary w-full cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
