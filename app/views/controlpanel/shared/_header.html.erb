<header class="bg-white border-b border-gray-200 px-6 py-4 lg:hidden">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-gray-900">Control Panel</h1>
    <%= button_to "Abmelden", destroy_user_session_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-700 cursor-pointer" %>
  </div>
  <nav class="flex gap-2 mt-4 overflow-x-auto pb-2">
    <% controlpanel_nav_items.each do |item| %>
      <%= link_to item[:label], item[:path], class: "whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium #{cp_nav_active?(item[:path]) ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600'}" %>
    <% end %>
  </nav>
</header>

<header class="bg-white border-b border-gray-200 px-6 py-4 hidden lg:flex items-center justify-between">
  <div>
    <% if content_for?(:page_title) %>
      <h2 class="text-xl font-bold text-gray-900"><%= yield :page_title %></h2>
    <% end %>
    <% if content_for?(:page_subtitle) %>
      <p class="text-sm text-gray-500 mt-1"><%= yield :page_subtitle %></p>
    <% end %>
  </div>
  <div class="flex items-center gap-4">
    <%= link_to "Website anzeigen", root_path, target: "_blank", class: "text-sm text-gray-500 hover:text-gray-700" %>
    <span class="text-sm text-gray-500"><%= current_user.email %></span>
  </div>
</header>
