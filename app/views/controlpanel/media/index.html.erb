<% content_for :page_title, "Media Library" %>
<% content_for :page_subtitle, "#{@attachments.count} files" %>

<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
  <% @attachments.each do |attachment| %>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <% if attachment.blob.content_type&.start_with?("image/") %>
        <%= image_tag attachment, class: "w-full aspect-square object-cover" %>
      <% else %>
        <div class="w-full aspect-square bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
          <%= attachment.filename %>
        </div>
      <% end %>
      <div class="p-3">
        <p class="text-xs text-gray-600 truncate"><%= attachment.filename %></p>
        <p class="text-xs text-gray-400"><%= number_to_human_size(attachment.byte_size) %></p>
        <%= button_to "Delete", controlpanel_medium_path(attachment), method: :delete, data: { turbo_confirm: "Delete this file?" }, class: "text-xs text-red-600 hover:underline mt-1 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

<% if @attachments.empty? %>
  <div class="bg-white rounded-xl border border-gray-200 p-12 text-center text-gray-500">
    No media files uploaded yet. Upload images through General Settings or Blog posts.
  </div>
<% end %>
