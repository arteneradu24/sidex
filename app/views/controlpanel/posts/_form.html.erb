<% content_for :page_title, @post.persisted? ? "Edit Post" : "New Post" %>

<div class="max-w-3xl">
  <%= render "shared/form_errors", object: @post %>
  <%= form_with model: @post, url: @post.persisted? ? controlpanel_post_path(@post) : controlpanel_posts_path, class: "space-y-6" do |f| %>
    <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
      <div>
        <%= f.label :title, class: "cp-label" %>
        <%= f.text_field :title, class: "cp-input" %>
      </div>
      <div>
        <%= f.label :slug, class: "cp-label" %>
        <%= f.text_field :slug, class: "cp-input", placeholder: "auto-generated from title" %>
      </div>
      <div>
        <%= f.label :excerpt, class: "cp-label" %>
        <%= f.text_area :excerpt, rows: 3, class: "cp-input" %>
      </div>
      <div>
        <%= f.label :content, class: "cp-label" %>
        <%= f.rich_text_area :content, class: "cp-input" %>
      </div>
      <div>
        <%= f.label :cover_image, class: "cp-label" %>
        <%= f.file_field :cover_image, class: "cp-input" %>
        <% if @post.cover_image.attached? %>
          <div class="mt-2"><%= image_tag @post.cover_image, class: "h-32 rounded-lg object-cover" %></div>
        <% end %>
      </div>
      <div class="flex items-center gap-4">
        <label class="flex items-center gap-2">
          <%= f.check_box :published, class: "rounded border-gray-300" %>
          <span class="text-sm text-gray-700">Published</span>
        </label>
        <div>
          <%= f.label :published_at, class: "cp-label" %>
          <%= f.datetime_local_field :published_at, class: "cp-input" %>
        </div>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Save Post", class: "btn-primary cursor-pointer" %>
      <%= link_to "Cancel", controlpanel_posts_path, class: "btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>
