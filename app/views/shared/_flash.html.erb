<% if notice.present? || alert.present? %>
  <div class="fixed top-20 right-4 z-50 space-y-2" data-controller="flash">
    <% if notice.present? %>
      <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl shadow-lg text-sm max-w-sm" data-flash-target="message">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl shadow-lg text-sm max-w-sm" data-flash-target="message">
        <%= alert %>
      </div>
    <% end %>
  </div>
<% end %>
