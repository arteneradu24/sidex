<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <% hero = page_hero_image_for(page) %>
    <% if hero.is_a?(String) %>
      <img src="<%= hero %>" alt="" class="w-full h-full object-cover">
    <% else %>
      <%= image_tag hero, class: "w-full h-full object-cover", alt: "" %>
    <% end %>
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/40"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
    <div class="max-w-2xl">
      <% if page.hero_title.present? %>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          <%= page.hero_title %>
        </h1>
      <% end %>
      <% if page.hero_subtitle.present? %>
        <p class="text-lg md:text-xl text-gray-200 mb-8 leading-relaxed">
          <%= page.hero_subtitle %>
        </p>
      <% end %>
      <% if page.hero_button_text.present? && page.hero_button_url.present? %>
        <%= link_to page.hero_button_text, page.hero_button_url, class: "btn-primary inline-flex" %>
      <% end %>
    </div>
  </div>
</section>
